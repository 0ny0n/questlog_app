<div class="row justify-content-center">
  <%# <div class="col-md-10"> %>
  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <h1 class="mb-4">Create New Quest</h1>
      <%= form_with model: @quest do |form| %>
        <div>
          <%= form.label :title %>
          <%= form.text_field :title, class: "form-control #{'is-invalid' if @quest.errors[:title].any?}" %>
          <% if @quest.errors[:title].any? %>
            <div class="invalid-feedback d-block">
              <%= @quest.errors.full_messages_for(:title).first %>
            </div>
          <% end %>
        </div>
        <div class="mb-3">
          <%= form.label :description %>
          <%= form.rich_text_area :description do %>
            <lexxy-prompt trigger="@" name="mention" src="<%= search_users_path %>" remote-filtering insert-editable-text>
            </lexxy-prompt>
          <% end %>
        </div>

        <div class="mb-3">
          <%= form.label :xp_reward, "XP Reward", class: "form-label" %>
          <%= form.number_field :xp_reward,
      class: "form-control #{'is-invalid' if @quest.errors[:xp_reward].any?}" %>
          <% if @quest.errors[:xp_reward].any? %>
            <div class="invalid-feedback d-block">
              <%= @quest.errors.full_messages_for(:xp_reward).first %>
            </div>
          <% end %>
        </div>
        <%= form.submit "Create Quest", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
  <%# </div> %>
</div>