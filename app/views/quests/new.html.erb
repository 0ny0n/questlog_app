<h1>Create New Quest</h1>

<%= form_with model: @quest do |form| %>
    <p>
        <%= form.label :title %>
        <%= form.text_field :title %>
    </p>

    <p>
        <%= form.label :description %>
        <%= form.text_area :description %>
    </p>

    <p>
        <%= form.label :xp_reward %>
        <%= form.number_field :xp_reward %>
    </p>
    
    <%= form.submit "Create Quest" %>

<% end %>