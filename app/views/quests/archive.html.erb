<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Archived Quests</h2>
  <div>
    <%= link_to "Active Quests", quests_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<ul class="nav nav-pills mb-4">
  <li class="nav-item">
    <%= link_to "All Archived", archive_quests_path(filter: "all"), class: "nav-link #{'active' if params[:filter].blank? || params[:filter] == 'all'}" %>
  </li>
  <li class="nav-item">
    <%= link_to "My Quests", archive_quests_path(filter: "my_quests"), class: "nav-link #{'active' if params[:filter] == 'my_quests'}" %>
  </li>
  <li class="nav-item">
    <%= link_to "Shared", archive_quests_path(filter: "shared"), class: "nav-link #{'active' if params[:filter] == 'shared'}" %>
  </li>
</ul>

<div class="quest-masonry-grid">
  <% @quests.each do |q| %>
    <%
      xp_color =
      if q.xp_reward >= 70
        "bg-warning text-dark"
      elsif q.xp_reward >= 30
        "bg-info text-dark"
      else
        "bg-secondary"
      end
    %>

    <div class="quest-card-wrapper">
      <div class="card shadow-sm border-0 h-100 bg-light opacity-75">
        <div class="card-body p-3 d-flex flex-column">
          
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title mb-0 fw-bold text-decoration-line-through"><%= q.title %></h5>
            <span class="badge <%= xp_color %> p-2">+<%= q.xp_reward %> XP</span>
          </div>

          <div class="mb-2">
            <% if q.user_id == current_user.id %>
              <span class="badge bg-primary text-light me-1 mb-1">👑 Created by You</span>
            <% else %>
              <span class="badge bg-secondary text-light me-1 mb-1">👑 Created by @<%= q.user.username %></span>
            <% end %>

            <% q.collaborators.each do |collab| %>
              <span class="badge bg-light text-dark border me-1 mb-1">👥 @<%= collab.username %></span>
            <% end %>
          </div>

          <div class="card-text mt-2 quest-body-clamped flex-grow-1 text-muted">
            <%= render_mentions(q.description) %>
          </div>
          
          <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
            <span class="text-muted small">Completed on <%= q.updated_at.strftime("%b %d, %Y") %></span>
            <%= link_to "View Details", quest_path(q), class: "btn btn-outline-secondary btn-sm" %>
          </div>
          
        </div>
      </div>
    </div>
  <% end %>
</div>