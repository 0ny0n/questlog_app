<%# <button class="btn btn-primary">Test Bootstrap</button> %>
<div class="card bg-dark text-white shadow-sm border-0 mb-4">
  <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-center">
    
    <div class="text-center text-md-start mb-3 mb-md-0">
      <h2 class="fw-bold mb-1">Welcome to <%= @app_name %></h2>
      <p class="text-secondary mb-0">Your daily quests await. Let's level up!</p>
    </div>

    <div class="text-center text-md-end">
      <h6 class="text-secondary mb-1">
        <%= @today.strftime("%B %d, %Y") %>
      </h6>
      <h4 class="fw-light mb-0">
        <span id="clock"><%= @current_time %></span>
      </h4>
    </div>

  </div>
</div>
<div class="row mb-4">
  <div class="col-md-6">
    <div class="card shadow-sm border-0 text-center p-3">
      <h6 class="text-muted">Current Quests</h6>
      <h2><%= @current_quests.count %></h2>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card shadow-sm border-0 text-center p-3">
      <h6 class="text-muted">Completed Quests</h6>
      <h2><%= @completed_quests.count %></h2>
    </div>
  </div>
</div>
<h4 class="mb-3">Active Quests</h4>
<div class="quest-masonry-grid">
  <% @current_quests.each do |q| %>
    <div class="quest-card-wrapper">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h6 class="card-title"><%= q.title %></h6>
          <div class="text-muted small">
            <%= q.description %>
          </div>
          <span class="badge bg-warning text-dark">
            +<%= q.xp_reward %> XP
          </span>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="card shadow-sm border-0 mt-4 mb-5">
  <div class="card-body">
    <h5 class="card-title mb-3">Quest Difficulty Distribution</h5>

    <%= pie_chart({
      "Low (< 30 XP)" => @low_difficulty,
      "Medium (30-69 XP)" => @medium_difficulty,
      "High (70+ XP)" => @high_difficulty
    }, 
    donut: true, 
    colors: ["#198754", "#ffc107", "#dc3545"], 
    legend: "bottom") %>
  </div>
</div>

<%# Update time in real time %>
<script>
  function updateClock() {
    const now = new Date();
    document.getElementById("clock").innerText = now.toLocaleTimeString();
  }

  setInterval(updateClock, 1000);
</script>