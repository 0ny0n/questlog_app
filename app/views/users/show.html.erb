<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h1 class="mb-3"><%= @user.username %></h1>
          <div class="mb-4">
            <span class="badge bg-primary">Level <%= @user.level %></span>
            <span class="badge bg-warning text-dark">XP: <%= @user.xp %></span>
          </div>

          <h5 class="mb-3">Quests</h5>
          <% if @user.quests.any? %>
            <ul class="list-group">
              <% @user.quests.each do |quest| %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <div>
                    <strong><%= quest.title %></strong>
                    <div class="text-muted small"><%= quest.description %></div>
                  </div>
                  <span class="badge <%= quest.completed ? 'bg-success' : 'bg-secondary' %>">
                    <%= quest.completed ? 'Completed' : 'Active' %>
                  </span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted">No quests yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>