<% @users.each do |user| %>
  <lexxy-prompt-item search="<%= user.username %>">
    <template type="menu">@<%= user.username %></template>
    <template type="editor">
      <a href="<%= user_path(user) %>" class="mention-chip">@<%= user.username %></a>
    </template>
  </lexxy-prompt-item>
<% end %>
